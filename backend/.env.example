# Copy to .env for local development. Hosted environments set these as real variables.
# Local Docker database (docker compose up -d). For Neon, paste its DIRECT connection string instead,
# e.g. postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/outpatient
# Separate database used by `npm run test:e2e` (created by docker-compose). Never point this at real data.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/outpatient_test
# Required in production. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
# Frontend origin(s) allowed to call the API, comma-separated (e.g. https://your-app.vercel.app).
CORS_ORIGIN=http://localhost:3001
CLINIC_TIMEZONE=Asia/Kolkata
BOOKING_WINDOW_DAYS=30
PORT=3000

# --- Clerk sign-in (optional; leave unset to keep using only the built-in email/password sign-in) ---
# Requires migration 005_external_identities.sql to be applied first (`npm run db:migrate`).
# Secret key from the Clerk dashboard (API keys). Keep it server-side only.
CLERK_SECRET_KEY=sk_test_e…oxWL
# Optional: your instance's PEM public key, lets tokens be verified without a network call (use \n for line breaks).
CLERK_JWT_KEY=
# Optional: comma-separated frontend origins allowed to mint session tokens. Defaults to CORS_ORIGIN.
CLERK_AUTHORIZED_PARTIES=http://localhost:3001

# --- Payments (Razorpay, optional; leave the keys unset and booking stays free, as before) ---
# Requires migration 006 (`npm run db:migrate`), which is needed by the new code even with payments off.
# Use TEST MODE keys (rzp_test_...) from the Razorpay dashboard until you go live. Keep both server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when creating the webhook in Razorpay (Settings > Webhooks). Not the API key secret.
RAZORPAY_WEBHOOK_SECRET=
# How long an unpaid booking holds its slot, in minutes.
PAYMENT_HOLD_MINUTES=15
# Patient cancellations: full refund at least this many hours before, a share later, nothing after. A doctor's cancellation is always a full refund.
REFUND_FULL_HOURS_BEFORE=24
REFUND_PARTIAL_HOURS_BEFORE=2
REFUND_PARTIAL_PERCENT=50

# --- Reminders and background work ---
# Hours before an appointment to send a reminder (by email and, when texts are set up, SMS), comma-separated; fractions such as 0.5
# are allowed. Empty turns reminders off. Appointments already booked pick up a changed list within about 10 minutes.
REMINDER_HOURS_BEFORE=24,1
# Set to false to stop the worker that releases unpaid holds, retries refunds and sends due emails (tests do this).
BACKGROUND_JOBS=true

# --- Email (appointment, payment and refund notices, and sign-up codes) ---
# Without RESEND_API_KEY, development prints emails in the server log. Production then has no email until a provider is set.
RESEND_API_KEY=
# The sender. It must be on a domain you have VERIFIED in Resend. The shared test sender (onboarding@resend.dev) only delivers to
# your own Resend account email, and Resend answers HTTP 403 (validation_error) for anyone else: the failed message is kept with
# Resend's reason, visible at GET /api/notifications/admin/failed.
EMAIL_FROM=CareSlot <notifications@your-verified-domain.example>

# --- SMS (text messages to patients; optional) ---
# Off unless all three Twilio settings are set. SMS_PROVIDER=mock prints texts in the server log instead (development only),
# and SMS_PROVIDER=disabled forces SMS off even when the credentials are present.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sending number (E.164, e.g. +15005550006) or a Twilio messaging sender registered for your account.
TWILIO_FROM_NUMBER=
# Patients' numbers saved without a country code are completed with this (e.g. +91). Empty: such numbers are not texted.
SMS_DEFAULT_COUNTRY_CODE=

# --- Notification delivery ---
# Tries per message before it is kept as FAILED, and the wait after the first failure (doubles after each, up to an hour).
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=60
